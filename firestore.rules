rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só enxerga a própria subárvore. O curinga {documento=**}
    // cobre veiculos e todas as subcoleções (manutencoes, abastecimentos,
    // lembretes, checklist) sem precisar repetir a regra em cada nível.
    match /users/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
